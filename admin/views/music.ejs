<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>音樂播放器 - OmniBot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #0a0a14; color: #e0e0e0; min-height: 100vh;
    }
    body::before {
      content: ''; position: fixed; top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: radial-gradient(ellipse at 30% 20%, rgba(52,152,219,0.08) 0%, transparent 50%),
                  radial-gradient(ellipse at 70% 80%, rgba(233,69,96,0.04) 0%, transparent 50%);
      pointer-events: none; z-index: 0;
    }
    .top-bar {
      position: relative; z-index: 1;
      display: flex; justify-content: space-between; align-items: center;
      padding: 16px 40px;
      background: rgba(12,12,24,0.8); backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .top-bar .logo { font-size: 20px; font-weight: 800; color: #fff; letter-spacing: -0.5px; }
    .top-bar .logo span { color: #7c6ff0; }
    .top-bar .right { display: flex; align-items: center; gap: 16px; }
    .top-bar .right a {
      color: #8888cc; text-decoration: none; font-size: 13px; font-weight: 500;
      transition: color 0.15s;
    }
    .top-bar .right a:hover { color: #fff; }

    .container { position: relative; z-index: 1; max-width: 580px; margin: 0 auto; padding: 40px 20px; }

    .player-card {
      background: linear-gradient(135deg, rgba(30,30,60,0.9), rgba(20,20,50,0.9));
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px; padding: 32px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4);
      position: relative;
    }
    .player-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, #3498db, #7c6ff0, #3498db);
      border-radius: 16px 16px 0 0;
    }

    .np-header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    .np-header .icon { font-size: 28px; }
    .np-header .title { font-size: 18px; font-weight: 700; color: #fff; }

    .song-info { display: flex; gap: 20px; margin-bottom: 24px; }
    .song-thumb {
      width: 120px; height: 120px; border-radius: 12px;
      background: rgba(42,42,74,0.6); flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 40px; overflow: hidden;
    }
    .song-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .song-meta { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 8px; }
    .song-title { font-size: 18px; font-weight: 700; color: #fff; line-height: 1.3; }
    .song-author { font-size: 13px; color: #8888cc; }
    .song-author span { color: #aaa; }

    .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 16px; }
    .meta-item { background: rgba(255,255,255,0.03); border-radius: 8px; padding: 10px 14px; }
    .meta-item .label { font-size: 11px; color: #5555aa; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; }
    .meta-item .value { font-size: 14px; font-weight: 600; color: #ddd; }

    .progress-section { margin-bottom: 20px; }
    .progress-bar-bg {
      background: rgba(255,255,255,0.06); height: 6px; border-radius: 3px;
      position: relative; overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%; border-radius: 3px;
      background: linear-gradient(90deg, #3498db, #7c6ff0);
      transition: width 0.3s ease;
    }
    .progress-times {
      display: flex; justify-content: space-between;
      font-size: 12px; color: #5555aa; margin-top: 4px;
    }

    .controls { display: flex; justify-content: center; gap: 8px; margin-bottom: 20px; }
    .ctrl-btn {
      width: 48px; height: 48px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.04);
      color: #ccc; font-size: 18px; cursor: pointer;
      transition: all 0.15s; display: flex; align-items: center; justify-content: center;
    }
    .ctrl-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.15); color: #fff; }
    .ctrl-btn:active { transform: scale(0.95); }
    .ctrl-btn.primary { background: #3498db; border-color: #3498db; color: #fff; }
    .ctrl-btn.primary:hover { background: #2980b9; }

    .vol-section {
      display: flex; align-items: center; gap: 12px;
      background: rgba(255,255,255,0.03); border-radius: 8px; padding: 8px 14px;
    }
    .vol-section .label { font-size: 12px; color: #5555aa; }
    .vol-section input[type=range] {
      flex: 1; -webkit-appearance: none; height: 4px; border-radius: 2px;
      background: rgba(255,255,255,0.1); outline: none;
    }
    .vol-section input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%;
      background: #3498db; cursor: pointer;
    }
    .vol-section .vol-val { font-size: 13px; font-weight: 600; color: #ddd; min-width: 36px; text-align: right; }

    .requester {
      margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.05);
      display: flex; align-items: center; gap: 10px;
      font-size: 13px; color: #6666aa;
    }
    .requester img { width: 24px; height: 24px; border-radius: 50%; }

    .next-section { margin-top: 12px; font-size: 12px; color: #5555aa; }
    .next-section strong { color: #8888cc; }

    .empty-state { text-align: center; padding: 60px 20px; color: #555; }
    .empty-state .big-icon { font-size: 48px; margin-bottom: 12px; }
    .empty-state h2 { font-size: 20px; color: #fff; margin-bottom: 6px; }
    .empty-state p { font-size: 13px; color: #5555aa; }

    .guild-select {
      width: 100%; padding: 10px 14px; border-radius: 8px;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
      color: #ddd; font-size: 14px; margin-bottom: 20px; outline: none;
    }
    .guild-select:focus { border-color: #3498db; }
  </style>
</head>
<body>
  <div class="top-bar">
    <div class="logo">Omni<span>Bot</span></div>
    <div class="right">
      <a href="/dashboard">儀表板</a>
      <a href="/cmd">指令</a>
      <a href="/logout" style="color:#e94560;">登出</a>
    </div>
  </div>

  <div class="container">
    <select class="guild-select" id="guildSelect">
      <option value="">-- 選擇有音樂播放的伺服器 --</option>
    </select>

    <div id="playerView">
      <div class="empty-state">
        <div class="big-icon">🎵</div>
        <h2>選擇伺服器</h2>
        <p>上方選擇一個正在播放音樂的伺服器</p>
      </div>
    </div>
  </div>

  <script>
    let currentGuildId = null;
    let pollInterval = null;

    async function fetchGuilds() {
      try {
        const res = await fetch('/api/music-guilds');
        const ids = await res.json();
        const sel = document.getElementById('guildSelect');
        const current = sel.value;
        sel.innerHTML = '<option value="">-- 選擇有音樂播放的伺服器 --</option>';
        for (const id of ids) {
          const opt = document.createElement('option');
          opt.value = id;
          opt.textContent = id;
          sel.appendChild(opt);
        }
        if (current && ids.includes(current)) sel.value = current;
      } catch {}
    }

    async function fetchState(guildId) {
      try {
        const res = await fetch(`/api/music/${guildId}`);
        return await res.json();
      } catch {
        return null;
      }
    }

    function formatTime(sec) {
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return `${m}:${String(s).padStart(2, '0')}`;
    }

    function renderPlayer(state) {
      const container = document.getElementById('playerView');
      if (!state || !state.playing || !state.currentSong) {
        container.innerHTML = `
          <div class="empty-state">
            <div class="big-icon">⏸️</div>
            <h2>目前沒有播放中的音樂</h2>
            <p>在 Discord 中使用 /play 來播放音樂</p>
          </div>`;
        return;
      }

      const song = state.currentSong;
      const totalSec = song.duration || 0;
      const currentSec = state.currentTime || 0;
      const pct = totalSec > 0 ? Math.min(100, (currentSec / totalSec) * 100) : 0;

      container.innerHTML = `
        <div class="player-card">
          <div class="np-header">
            <div class="icon">🎵</div>
            <div class="title">正在播放</div>
          </div>

          <div class="song-info">
            <div class="song-thumb">
              ${song.thumbnail ? `<img src="${song.thumbnail}" alt="">` : '🎵'}
            </div>
            <div class="song-meta">
              <div class="song-title">${song.title || '未知'}</div>
              <div class="song-author">作者 <span>${song.author || '未知'}</span></div>
            </div>
          </div>

          <div class="meta-grid">
            <div class="meta-item">
              <div class="label">時長</div>
              <div class="value">${totalSec === 0 ? '直播' : formatTime(totalSec)}</div>
            </div>
            <div class="meta-item">
              <div class="label">循環</div>
              <div class="value">${state.loop ? '開啟' : '關閉'}</div>
            </div>
          </div>

          <div class="progress-section">
            <div class="progress-bar-bg">
              <div class="progress-bar-fill" style="width:${pct}%"></div>
            </div>
            <div class="progress-times">
              <span>${formatTime(currentSec)}</span>
              <span>${totalSec === 0 ? '直播' : formatTime(totalSec)}</span>
            </div>
          </div>

          <div class="controls" style="margin-bottom:20px">
            <button class="ctrl-btn" onclick="sendControl('loop')" title="切換循環">
              ${state.loop ? '🔁' : '🔂'}
            </button>
            <button class="ctrl-btn" onclick="sendControl('toggle')" title="暫停/播放">⏯️</button>
            <button class="ctrl-btn primary" onclick="sendControl('skip')" title="下一首">⏭️</button>
          </div>

          <div class="vol-section">
            <span class="label">🔊</span>
            <input type="range" min="0" max="100" value="${state.volume}"
              oninput="this.nextElementSibling.textContent=this.value+'%'"
              onchange="sendControl('volume', this.value)">
            <span class="vol-val">${state.volume}%</span>
          </div>

          ${song.requester ? `
            <div class="requester">
              ${song.requester.avatar ? `<img src="${song.requester.avatar}" alt="">` : ''}
              由 ${song.requester.tag} 點播
            </div>` : ''}

          ${state.nextSong ? `
            <div class="next-section">
              下一首：<strong>${state.nextSong.title}</strong>
            </div>` : ''}
        </div>`;
    }

    async function sendControl(action, value) {
      if (!currentGuildId) return;
      try {
        await fetch(`/api/music/${currentGuildId}/control`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, value }),
        });
      } catch {}
    }

    async function poll() {
      if (!currentGuildId) return;
      const state = await fetchState(currentGuildId);
      renderPlayer(state);
    }

    document.getElementById('guildSelect').addEventListener('change', async (e) => {
      currentGuildId = e.target.value;
      if (pollInterval) clearInterval(pollInterval);
      if (!currentGuildId) {
        document.getElementById('playerView').innerHTML = `
          <div class="empty-state">
            <div class="big-icon">🎵</div>
            <h2>選擇伺服器</h2>
            <p>上方選擇一個正在播放音樂的伺服器</p>
          </div>`;
        return;
      }
      poll();
      pollInterval = setInterval(poll, 3000);
    });

    fetchGuilds();
    setInterval(fetchGuilds, 10000);
  </script>
</body>
</html>
